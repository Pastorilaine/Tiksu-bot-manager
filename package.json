{
  "name": "tiksu-bot-manager",
  "version": "1.8.0",
  "description": "Tiksu Bot Manager – IT-Veljekset hallintapaneeli",
  "author": "IT-Veljekset Group",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npx kill-port 5173 --silent & concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --host 127.0.0.1\" \"electron .\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "test": "node test/updater.test.js && node test/secrets.test.js",
    "build:app": "npm run build && electron-builder",
    "release:win": "npm run build && electron-builder --win --publish always",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^7.0.3",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "kill-port": "^2.0.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.itveljekset.tiksu-bot-manager",
    "productName": "Tiksu Bot Manager",
    "artifactName": "Tiksu-Bot-Manager-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "assets/tiksu_bots_trans.png",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Tiksu Bot Manager"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pastorilaine",
        "repo": "Tiksu-bot-manager",
        "releaseType": "release"
      }
    ]
  }
}
